<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Shield / Hexagon Ring -->
    <path
        android:pathData="M54,23 L79,37 L79,67 L54,83 L29,67 L29,37 Z"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="29"
                android:startY="23"
                android:endX="79"
                android:endY="83"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#2563EB" android:offset="0.6" />
                <item android:color="#8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Speed Lightning Bolt & Booster Rocket -->
    <path
        android:pathData="M57,29 L41,52 L52,52 L47,77 L67,50 L55,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41"
                android:startY="29"
                android:endX="67"
                android:endY="77"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="0.4" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dynamic Speed Flare Accents -->
    <path
        android:pathData="M69,38 L75,41 M39,69 L33,72 M71,64 L75,66"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF" />
</vector>
